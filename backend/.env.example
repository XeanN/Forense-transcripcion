# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Usuario admin inicial (usado solo por el script de seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_contrasena_temporal
ADMIN_EMAIL=admin@example.com

# Base de datos SQLite
DB_PATH=./src/db/forense.db

# Gmail (Nodemailer) para recuperacion de contrasena
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_app_password_de_16_caracteres

# URL base del frontend, usada para construir el link de reseteo de contrasena
FRONTEND_URL=http://localhost:3000

# Tamano maximo de archivo permitido en la subida, en MB. 3072 = 3 GB.
# El backend lo aplica siempre; el frontend tambien lo valida antes de
# subir el archivo para no gastar ancho de banda en vano.
MAX_FILE_SIZE_MB=3072

# Duracion de cada chunk de audio/video en minutos
CHUNK_DURATION_MINUTES=15

# Ruta al ejecutable de Python que tiene faster-whisper instalado
# (usa el de la venv del proyecto, ver README)
PYTHON_BIN=./python/.venv/Scripts/python.exe

# Tamano del modelo de whisper: tiny, base, small, medium, large-v3
# small es un buen balance velocidad/precision corriendo en CPU
WHISPER_MODEL_SIZE=small

# int8 es el mas rapido en CPU. Alternativas: int8_float16, float32
WHISPER_COMPUTE_TYPE=int8

# Codigo de idioma (ej. "es"). Vacio = auto-detectar
WHISPER_LANGUAGE=es

# 0 = permite descargar el modelo de Hugging Face si todavia no esta
# cacheado (necesario la primera vez que se transcribe algo).
# 1 = no intentar contactar Hugging Face, usa solo el modelo ya cacheado en
# ~/.cache/huggingface/hub. Cambialo a 1 despues de la primera transcripcion
# exitosa para que la app nunca vuelva a intentar salir a internet.
HF_HUB_OFFLINE=0
